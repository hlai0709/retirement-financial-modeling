{
  "version": 1,
  "accountant_intro": "AI Mode: gather the same documents a CPA would ask for. Local parsers + local AI only extract numbers already on your documents (not advice). You review and apply; fill gaps yourself. Use AI Estimates later only for market/healthcare assumptions.",
  "documents": [
    {
      "id": "plaid_accounts",
      "tier": "A",
      "label": "Bank & investment accounts",
      "accountant_prompt": "Link read-only access so we can pull current balances (Chase, Fidelity, etc.).",
      "formats": ["api"],
      "acquisition": "plaid_link",
      "parser_id": "plaid_balances",
      "parser_config_version": "1",
      "required_for_core": true,
      "person_scope": "household",
      "fields": ["initial_assets"]
    },
    {
      "id": "plaid_spending",
      "tier": "A",
      "label": "Spending (cards & checking)",
      "accountant_prompt": "Same Plaid connection — we analyze up to two years of transactions for annual spending.",
      "formats": ["api"],
      "acquisition": "plaid_refresh_expenses",
      "parser_id": "plaid_expenses",
      "parser_config_version": "1",
      "required_for_core": true,
      "person_scope": "household",
      "fields": ["base_expenses"]
    },
    {
      "id": "form_1040",
      "tier": "A",
      "label": "Federal tax return (Form 1040)",
      "accountant_prompt": "Your most recent complete return — all pages if you itemize (Schedule A, E, etc.).",
      "formats": ["pdf", "json"],
      "acquisition": "upload",
      "parser_id": "tax_return",
      "parser_config_version": "2024_v1",
      "config_path": "config/lazy_mode/parsers/tax_return_2024_v1.json",
      "required_for_core": true,
      "person_scope": "household",
      "fields": [
        "annual_earned_income",
        "state_of_residence",
        "filing_status_after_marriage",
        "itemized_salt_annual",
        "itemized_mortgage_interest",
        "itemized_charitable",
        "itemized_medical",
        "property_tax_annual",
        "pre_retire_tax_rate",
        "pension_amount",
        "rental_income_start"
      ]
    },
    {
      "id": "pay_stub",
      "tier": "A",
      "label": "Pay stub (recent)",
      "accountant_prompt": "Recent digital PDF pay stub (YTD preferred). Fills 401(k)/Roth split, income, and employee health premiums (Medical/Dental/Vision → Employer Health Monthly).",
      "formats": ["pdf"],
      "acquisition": "upload",
      "parser_id": "pay_stub",
      "parser_config_version": "v1",
      "config_path": "config/lazy_mode/parsers/pay_stub_v1.json",
      "required_for_core": false,
      "person_scope": "person",
      "ready": true,
      "fields": [
        "contribution_roth_pct",
        "annual_contributions",
        "annual_earned_income",
        "employer_health_mode",
        "employer_health_monthly",
        "health_insurance_pre_medicare"
      ]
    },
    {
      "id": "market_data",
      "tier": "A",
      "label": "Market assumptions",
      "accountant_prompt": "No document needed — we refresh inflation and return assumptions from public data.",
      "formats": ["api"],
      "acquisition": "refresh_market",
      "parser_id": "market_fred",
      "parser_config_version": "1",
      "required_for_core": true,
      "person_scope": "household",
      "fields": ["inflation_rate", "investment_return_mean"]
    },
    {
      "id": "ssa_1099",
      "tier": "B",
      "label": "Social Security statement",
      "accountant_prompt": "Upload your my Social Security statement PDF (benefit chart ages 62–70) or SSA-1099. We fill claim age, monthly PIA, annual benefit, and set benefit mode to PIA.",
      "formats": ["pdf"],
      "acquisition": "upload",
      "parser_id": "ssa_1099",
      "parser_config_version": "2024_v1",
